
# Neon — gerado por `neon deploy` / `neon env pull` em .env.local
DATABASE_URL=postgresql://...
DATABASE_URL_UNPOOLED=postgresql://...

# IA — configuração genérica (troque para qualquer provedor)
IA_API_URL=https://...
IA_API_KEY=sk...
IA_MODEL=name-of-the-model
IA_MAX_TOKENS=6000

# Porta (opcional, padrão 3000)
PORT=3000
NODE_ENV=development